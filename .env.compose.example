MEDIASOUP_ANNOUNCED_ADDRESS=192.0.2.10

BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=4443
WEB_OUTPUT_DIRECTORY=./build/web

MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
