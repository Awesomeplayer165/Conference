# Copy to .env or pass with: docker compose --env-file .env.compose up --build
# Use an IP address that host and viewer browsers can both reach.
MEDIASOUP_ANNOUNCED_ADDRESS=192.0.2.10

BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=4443
WEB_OUTPUT_DIRECTORY=./build/web

# All peer transports share this single UDP/TCP port.
MEDIASOUP_PORT=40000
# Larger socket queues absorb high-bitrate keyframe and motion bursts.
MEDIASOUP_SOCKET_BUFFER_BYTES=4194304
